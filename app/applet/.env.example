# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Local Ollama AI Settings (Optional, defaults to http://localhost:11434 and phi3:mini)
OLLAMA_URL=
OLLAMA_MODEL=

# Supabase Remote Sync (Optional, falls back to local JSON storage if unset)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
SUPABASE_ANON_KEY=

# JWT Authentication Secret (Server-side)
JWT_SECRET=
